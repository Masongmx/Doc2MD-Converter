<UserControl x:Class="Doc2MD.Controls.ModeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">
    <!-- U7: 模式卡片。由 MainWindow 中三段重复卡片提取而来，通过依赖属性注入文案。 -->
    <Button Click="OnCardClick"
            IsEnabled="{Binding IsEnabled, ElementName=Root}"
            AutomationProperties.Name="{Binding AutomationName, ElementName=Root}">
        <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ModeCardStyle}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding IsMotionOff}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.85" To="1" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, ElementName=Root}" Value="True"/>
                            <Condition Binding="{Binding IsMotionOff}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Opacity" Value="1"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Document-shaped icon with corner fold -->
            <Grid Width="42" Height="52" Margin="0,0,14,0">
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" BorderBrush="{DynamicResource ModeIconBorderBrush}" BorderThickness="1.5"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Background="{DynamicResource ModeIconCornerBrush}">
                    <Border CornerRadius="0,4,0,4" Background="{DynamicResource ModeIconCornerBrush}"/>
                </Border>
                <TextBlock Text="{Binding IconText, ElementName=Root}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,2,0,0"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ModeName, ElementName=Root}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description, ElementName=Root}" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding SubDescription, ElementName=Root}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
