<Window x:Class="Doc2MD.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}">
    <Grid Margin="18">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Border Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.RowSpan="2"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectedValue="{Binding SelectedHelpSection, Mode=TwoWay}"
                         SelectedValuePath="Content"
                         ItemContainerStyle="{StaticResource DialogNavButtonStyle}">
                    <ListBoxItem Content="使用指南"/>
                    <ListBoxItem Content="快速开始"/>
                    <ListBoxItem Content="Markdown 转 DOCX"/>
                    <ListBoxItem Content="文档转 Markdown"/>
                    <ListBoxItem Content="一键排版"/>
                    <ListBoxItem Content="常见问题"/>
                    <ListBoxItem Content="联系我们"/>
                </ListBox>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="使用指南">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="使用指南" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="1. 选择一个功能模式" Margin="0,0,0,10"/>
                                <TextBlock Text="2. 添加文件或文件夹" Margin="0,0,0,10"/>
                                <TextBlock Text="3. 选择输出目录" Margin="0,0,0,10"/>
                                <TextBlock Text="4. 检查文件状态" Margin="0,0,0,10"/>
                                <TextBlock Text="5. 点击生成按钮"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="快速开始">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="快速开始" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <Button Content="Markdown 转 DOCX 指南" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="GoMarkdownToDocx_Click"/>
                                <Button Content="文档转 Markdown 指南" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="GoDocToMarkdown_Click"/>
                                <Button Content="一键排版指南" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="GoFormatDoc_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="Markdown 转 DOCX">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Markdown 转 DOCX" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="支持 .md / .markdown 文件" Margin="0,0,0,10"/>
                                <TextBlock Text="支持批量转换" Margin="0,0,0,10"/>
                                <TextBlock Text="建议先选择输出目录" Margin="0,0,0,10"/>
                                <TextBlock Text="可在预览设置中选择 DOCX 模板"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="文档转 Markdown">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="文档转 Markdown" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="支持 PDF / Word / Excel / PPT" Margin="0,0,0,10"/>
                                <TextBlock Text="转换结果保存为 Markdown 文本" Margin="0,0,0,10"/>
                                <TextBlock Text="复杂表格和扫描版 PDF 可能需要人工校对"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="一键排版">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="一键排版" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="用于统一字体、标题、段落、页边距" Margin="0,0,0,10"/>
                                <TextBlock Text="适合报告、公文、论文初稿整理" Margin="0,0,0,10"/>
                                <TextBlock Text="可在设置中选择默认排版模板"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="常见问题">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="常见问题" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="Q：文件会上传到云端吗？" FontWeight="SemiBold"/>
                                <TextBlock Text="A：不会。所有处理都在本地完成。" Margin="0,4,0,14"/>
                                <TextBlock Text="Q：为什么有些文件显示“不支持”？" FontWeight="SemiBold"/>
                                <TextBlock Text="A：当前模式只支持特定文件格式，例如 Markdown 转 DOCX 只支持 .md / .markdown。" Margin="0,4,0,14"/>
                                <TextBlock Text="Q：转换失败怎么办？" FontWeight="SemiBold"/>
                                <TextBlock Text="A：可以点击失败文件右侧的“重试”，或查看日志目录。" Margin="0,4,0,14"/>
                                <TextBlock Text="Q：输出目录为空会怎样？" FontWeight="SemiBold"/>
                                <TextBlock Text="A：默认保存到源文件所在目录，除非你在设置中指定了默认输出目录。" Margin="0,4,0,14"/>
                                <TextBlock Text="Q：支持子文件夹扫描吗？" FontWeight="SemiBold"/>
                                <TextBlock Text="A：支持，可在设置 > 转换设置中开启或关闭。" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHelpSection}" Value="联系我们">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="联系我们" Style="{StaticResource DialogSectionTitleStyle}"/>
                                <TextBlock Text="反馈和日志请在本地日志目录中查看。" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="打开日志目录" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLogs_Click"/>
                                    <Button Content="复制软件信息" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="CopyInfo_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
