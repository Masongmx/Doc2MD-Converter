<Window x:Class="Doc2MD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Doc2MD.ViewModels"
        mc:Ignorable="d"
        Title="Doc2MD Converter"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/DocProcessorIcon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- v3: Single unified container with visible rounded border -->
    <Border Background="{DynamicResource BgCardBrush}"
            CornerRadius="12"
            Margin="12"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Padding="0,0,0,4"
            Effect="{StaticResource AppContainerShadow}">
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/><!-- divider -->
                <RowDefinition Height="Auto"/><!-- mode cards -->
                <RowDefinition Height="Auto"/><!-- divider -->
                <RowDefinition Height="*"/><!-- main content -->
                <RowDefinition Height="Auto"/><!-- divider -->
                <RowDefinition Height="40"/><!-- footer -->
            </Grid.RowDefinitions>

            <!-- ====== HEADER (integrated, no card border) ====== -->
            <Grid Grid.Row="0" Margin="24,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="{DynamicResource BgActiveBrush}" CornerRadius="10">
                        <TextBlock Text="文" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Doc2MD Converter" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource AppHeaderButtonStyle}" Click="Settings_Click" AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="设置"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppHeaderButtonStyle}" Click="Help_Click" Margin="4,0,0,0" AutomationProperties.Name="帮助">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="帮助"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppHeaderButtonStyle}" Click="Minimize_Click" Margin="12,0,0,0" Width="40" Height="32" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource AppHeaderButtonStyle}" Click="ToggleMaximize_Click" Margin="4,0,0,0" Width="40" Height="32" AutomationProperties.Name="最大化">
                        <TextBlock Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource DangerHeaderButtonStyle}" Click="Close_Click" Margin="4,0,0,0" Width="40" Height="32" AutomationProperties.Name="关闭">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ====== DIVIDER below header ====== -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="24,0"/>

            <!-- ====== MODE CARDS (document-shaped icons with corner fold) ====== -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="24,12,24,12">
                <Button Click="ModeToMarkdown_Click" IsEnabled="{Binding CanChangeMode}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedModeIndex}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Document-shaped icon with "M" label and corner fold -->
                        <Grid Width="42" Height="52" Margin="0,0,14,0">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" BorderBrush="{DynamicResource ModeIconBorderBrush}" BorderThickness="1.5"/>
                            <!-- Corner fold (top-right) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Background="{DynamicResource ModeIconCornerBrush}">
                                <Border CornerRadius="0,4,0,4" Background="{DynamicResource ModeIconCornerBrush}"/>
                            </Border>
                            <TextBlock Text="M" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="文档转 Markdown" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="支持 PDF / Word / Excel / PPT" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="本地解析，提取文本内容" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Click="ModeMarkdownToDocx_Click" IsEnabled="{Binding CanChangeMode}" Margin="3,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedModeIndex}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="42" Height="52" Margin="0,0,14,0">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" BorderBrush="{DynamicResource ModeIconBorderBrush}" BorderThickness="1.5"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Background="{DynamicResource ModeIconCornerBrush}">
                                <Border CornerRadius="0,4,0,4" Background="{DynamicResource ModeIconCornerBrush}"/>
                            </Border>
                            <TextBlock Text="D" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Markdown 转 DOCX" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="按照公文格式生成 Word 文档" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="批量转换，高效稳定" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Click="ModeFormatDoc_Click" IsEnabled="{Binding CanChangeMode}" Margin="6,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedModeIndex}" Value="2">
                                    <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="42" Height="52" Margin="0,0,14,0">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" BorderBrush="{DynamicResource ModeIconBorderBrush}" BorderThickness="1.5"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Background="{DynamicResource ModeIconCornerBrush}">
                                <Border CornerRadius="0,4,0,4" Background="{DynamicResource ModeIconCornerBrush}"/>
                            </Border>
                            <TextBlock Text="排" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="一键排版" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="统一字体、标题、段落与页边距" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="规范化排版，提升文档质量" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- ====== DIVIDER below mode cards ====== -->
            <Border Grid.Row="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="24,0"/>

            <!-- ====== MAIN CONTENT AREA ====== -->
            <Grid Grid.Row="4" Margin="24,14,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- toolbar -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/><!-- output dir -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><!-- folder summary -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/><!-- file list + drop zone -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- progress + actions -->
                </Grid.RowDefinitions>

                <!-- Toolbar row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource DarkButtonStyle}" Click="AddFiles_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="＋"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="{Binding AddFileButtonText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Content="添加文件夹" Style="{StaticResource SecondaryButtonStyle}" Click="AddFolder_Click" Margin="8,0,0,0"/>
                        <Button Content="清空" Style="{StaticResource GhostButtonStyle}" Click="ClearFiles_Click" Margin="8,0,0,0" IsEnabled="{Binding CanClearFiles}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="刷新" Style="{StaticResource ToolbarSecondaryButtonStyle}" Click="RefreshFolder_Click" IsEnabled="{Binding CanUseFolderActions}"/>
                        <Button Content="打开文件夹" Style="{StaticResource ToolbarSecondaryButtonStyle}" Click="OpenFolder_Click" Margin="8,0,0,0" IsEnabled="{Binding CanUseFolderActions}"/>
                        <Button Content="更换文件夹" Style="{StaticResource ToolbarSecondaryButtonStyle}" Click="ChangeFolder_Click" Margin="8,0,0,0" IsEnabled="{Binding CanUseFolderActions}"/>
                    </StackPanel>
                </Grid>

                <!-- Output directory row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输出目录" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding ActiveOutputDirectory, UpdateSourceTrigger=PropertyChanged}" MaxWidth="600" TextWrapping="NoWrap"/>
                        <TextBlock Text="请选择输出目录，默认使用源文件所在目录"
                                   Margin="14,0,0,0"
                                   Foreground="{DynamicResource TextWeakBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ActiveOutputDirectory, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                    </Grid>
                    <Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseOutput_Click" Margin="10,0,0,0"/>
                    <Button Grid.Column="3" Content="打开" Style="{StaticResource SecondaryButtonStyle}" Click="OpenOutput_Click" Margin="8,0,0,0" IsEnabled="{Binding CanOpenOutputDirectory}"/>
                </Grid>

                <!-- Folder summary -->
                <Border Grid.Row="4"
                        Background="{DynamicResource BgActiveBrush}"
                        CornerRadius="8"
                        Padding="14,8"
                        Visibility="{Binding HasCurrentFolderSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentFolderSummaryText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- File list + Drop zone -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="38*"/>
                    </Grid.ColumnDefinitions>

                    <!-- File list: no outer border, just background -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgFileListBrush}"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FileListTransitionPhase}" Value="exit">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                     To="-16"
                                                                     Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FileListTransitionPhase}" Value="enter">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                     From="20"
                                                                     To="0"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="16,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" SharedSizeGroup="ColName"/>
                                    <ColumnDefinition Width="4*" SharedSizeGroup="ColPath"/>
                                    <ColumnDefinition Width="2*" SharedSizeGroup="ColStatus"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColAction"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件名" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="路径" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="状态" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="操作" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding ActiveFiles}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="8,0,8,0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="{DynamicResource BgCardBrush}"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            Margin="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" SharedSizeGroup="ColName"/>
                                                <ColumnDefinition Width="4*" SharedSizeGroup="ColPath"/>
                                                <ColumnDefinition Width="2*" SharedSizeGroup="ColStatus"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColAction"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" Background="{DynamicResource BgActiveBrush}" CornerRadius="6">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource FileTypeIconConverter}}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FullPath}"
                                                       Margin="8,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="2"
                                                    Background="{Binding Status, Converter={StaticResource FileStatusBackgroundConverter}}"
                                                    CornerRadius="999"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="{Binding ErrorMessage}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,1,5,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource FileStatusForegroundConverter}}"
                                                             Visibility="{Binding Status, Converter={StaticResource FileStatusProcessingVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource FileStatusTextConverter}}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource FileStatusForegroundConverter}}"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Column="3"
                                                    Content="{Binding Status, Converter={StaticResource FileStatusActionTextConverter}}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="60"
                                                    Padding="10,5"
                                                    Margin="8,0,0,0"
                                                    FontSize="12"
                                                    Tag="{Binding}"
                                                    Click="FileAction_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Grid.Row="1" Panel.ZIndex="3" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource BgCardBrush}">
                                <StackPanel VerticalAlignment="Center" Margin="24">
                                    <TextBlock Text="{Binding ScanStatusPrimary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ScanStatusSecondary}" Margin="0,8,0,0" FontSize="12.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <Border Height="12" Margin="40,24,40,0" Background="{DynamicResource SkeletonPrimaryBrush}" CornerRadius="6"/>
                                    <Border Height="12" Margin="40,12,72,0" Background="{DynamicResource SkeletonSecondaryBrush}" CornerRadius="6"/>
                                    <Border Height="12" Margin="40,12,56,0" Background="{DynamicResource SkeletonPrimaryBrush}" CornerRadius="6"/>
                                    <Border Height="12" Margin="40,12,80,0" Background="{DynamicResource SkeletonSecondaryBrush}" CornerRadius="6"/>
                                    <Border Height="12" Margin="40,12,48,0" Background="{DynamicResource SkeletonPrimaryBrush}" CornerRadius="6"/>
                                    <Button Content="取消扫描" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="CancelProcessing_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Panel.ZIndex="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding ActiveFiles.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                                <TextBlock Text="暂无文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="点击「添加文件」或将文件拖拽到此处" FontSize="12.5" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Drop zone (wider, ~38%) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource DropZoneBackgroundBrush}"
                            BorderBrush="{DynamicResource DropZoneBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            MouseLeftButtonDown="DropZone_Click"
                            AutomationProperties.Name="拖拽上传区域">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource DropZoneBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DropZoneBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" Background="{DynamicResource BgCardBrush}" CornerRadius="16" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding DropZoneTitle}" Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DropZoneSubtitle}" Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DropZoneFootnote}" Margin="0,5,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DragActiveText}" Margin="0,14,0,0" FontSize="12.5" Foreground="{DynamicResource PrimaryBrush}" TextAlignment="Center" Visibility="{Binding IsDragActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Progress + action buttons -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="生成进度" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ProcessProgressText}" Margin="12,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ProcessProgressPercentText}" Margin="12,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Grid Margin="0,8,80,0" MinWidth="120" MaxWidth="300" HorizontalAlignment="Left" x:Name="ProgressTrack">
                            <Border Height="6" Background="{DynamicResource ProgressTrackBrush}" CornerRadius="999"/>
                            <Border Height="6"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="999"
                                    Width="{Binding ProcessProgressPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=220}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="输出设置" Style="{StaticResource SecondaryButtonStyle}" Click="PreviewSettings_Click"/>
                        <Button Content="取消" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" Click="CancelProcessing_Click" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="{Binding PrimaryActionText}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="PrimaryAction_Click" IsEnabled="{Binding CanPrimaryAction}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ====== DIVIDER above footer ====== -->
            <Border Grid.Row="5" Height="1" Background="{DynamicResource DividerBrush}" Margin="24,0"/>

            <!-- ====== FOOTER (integrated, no card border) ====== -->
            <Grid Grid.Row="6" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" AutomationProperties.Name="状态指示"/>
                    <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="本地处理 · 离线安全 · 文件不会上传" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding ProcessingCount, StringFormat=处理中：{0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DoneCount, StringFormat=    完成：{0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FailedCount, StringFormat=    失败：{0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PendingCount, StringFormat=    待处理：{0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Toast notification -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Padding="14,10"
                    Panel.ZIndex="20"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{Binding ToastTone, Converter={StaticResource ToastBackgroundConverter}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{Binding ToastTone, Converter={StaticResource ToneBrushConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</Window>
