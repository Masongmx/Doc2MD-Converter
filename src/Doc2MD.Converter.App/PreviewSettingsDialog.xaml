<Window x:Class="Doc2MD.PreviewSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Doc2MD.Models;assembly=Doc2MD.Converter.Core"
        xmlns:cn="clr-namespace:Doc2MD.Constants;assembly=Doc2MD.Converter.Core"
        xmlns:conv="clr-namespace:Doc2MD.Converters"
        Title="输出设置"
        Width="720"
        Height="750"
        MinWidth="600"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}">

    <Window.Resources>
        <conv:FontSizeToChineseConverter x:Key="FontSzCn"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Border Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="输出设置" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentModeTitle}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- ========== MarkdownToDocx 面板 (SelectedModeIndex=1) ========== -->
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedModeIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Pipeline 模板选择 -->
                                <TextBlock Text="排版模板" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox SelectedValue="{Binding Settings.Preview.MarkdownToDocx.PipelineTemplateId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="正式报告（GB/T 9704-2012）" Tag="official-report"/>
                                        <ComboBoxItem Content="会议纪要（常规边距）" Tag="meeting-minutes"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="应用模板设置" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="ApplyPipelineTemplate_Click"/>
                                </Grid>
                                <TextBlock Text="选择模板后点击「应用模板设置」可将模板参数填充到下方，也可直接修改各项参数" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="当前排版以模板参数为准，下方字段供预览参考" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- 字体 -->
                                <TextBlock Text="字体" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="标题字体" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.TitleFont, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="二级标题" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.HeadingFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="三级标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.SubheadingFont, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="正文" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.BodyFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代码块" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.CodeBlockFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 字号 -->
                                <TextBlock Text="字号" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.MarkdownToDocx.TitleFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="二级标题" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.MarkdownToDocx.HeadingFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="三级标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.MarkdownToDocx.SubheadingFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="正文" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.MarkdownToDocx.BodyFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代码块" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.MarkdownToDocx.CodeBlockFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 间距 -->
                                <TextBlock Text="间距与缩进" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="行距(磅)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.LineSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="首行缩进(字符)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.FirstLineIndentChars, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="段前(磅)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.BeforeSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="段后(磅)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.AfterSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 页边距 -->
                                <TextBlock Text="页边距（cm）" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="上" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.PageMarginTopCm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="下" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.PageMarginBottomCm, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="左" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.PageMarginLeftCm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="右" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.MarkdownToDocx.PageMarginRightCm, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <CheckBox Content="生成目录" IsChecked="{Binding Settings.Preview.MarkdownToDocx.GenerateToc}" Margin="0,0,0,10"/>
                                <CheckBox Content="保留图片" IsChecked="{Binding Settings.Preview.MarkdownToDocx.KeepImages}" Margin="0,0,0,10"/>

                                <!-- 页眉页脚 -->
                                <TextBlock Text="页眉页脚" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="页眉文本" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.HeaderText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="页脚文本" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.MarkdownToDocx.FooterText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== DocumentToMarkdown 面板 (SelectedModeIndex=0) ========== -->
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedModeIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <CheckBox Content="是否提取图片" IsChecked="{Binding Settings.Preview.DocumentToMarkdown.ExtractImages}" Margin="0,0,0,10"/>
                                <CheckBox Content="是否保留表格" IsChecked="{Binding Settings.Preview.DocumentToMarkdown.PreserveTables}" Margin="0,0,0,10"/>
                                <CheckBox Content="是否按页面分段" IsChecked="{Binding Settings.Preview.DocumentToMarkdown.SplitByPage}" Margin="0,0,0,10"/>
                                <CheckBox Content="OCR 识别（扫描件 PDF 自动调用本地 OCR）" IsChecked="{Binding Settings.Preview.DocumentToMarkdown.EnableOcr}"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== FormatDoc 面板 (SelectedModeIndex=2) ========== -->
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedModeIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- 排版方案选择 -->
                                <TextBlock Text="排版方案" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox SelectedValue="{Binding Settings.Preview.FormatDoc.FormatScheme, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="标准公文格式"/>
                                        <ComboBoxItem Content="企业增强版"/>
                                        <ComboBoxItem Content="学术论文格式"/>
                                        <ComboBoxItem Content="自定义"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="导入方案" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ImportProfile_Click_formatdoc"/>
                                    <Button Grid.Column="2" Content="导出方案" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ExportProfile_Click_formatdoc"/>
                                    <Button Grid.Column="3" Content="应用方案" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="ApplyProfile_Click_formatdoc"/>
                                </Grid>
                                <TextBlock Text="选择方案后点击「应用方案」填充下方设置，也可直接修改各项参数" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- 字体 -->
                                <TextBlock Text="字体" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="标题字体" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.TitleFont, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="二级标题" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.HeadingFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="三级标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.SubheadingFont, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="正文" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.BodyFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代码块" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.CodeBlockFont, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 字号 -->
                                <TextBlock Text="字号" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.FormatDoc.TitleFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="二级标题" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.FormatDoc.HeadingFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="三级标题" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.FormatDoc.SubheadingFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="正文" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.FormatDoc.BodyFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代码块" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static cn:ChineseFontSize.AllNames}" SelectedItem="{Binding Settings.Preview.FormatDoc.CodeBlockFontSizePt, Converter={StaticResource FontSzCn}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 间距 -->
                                <TextBlock Text="间距与缩进" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="行距(磅)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.LineSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="首行缩进(字符)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.FirstLineIndentChars, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="段前(磅)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.BeforeSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="段后(磅)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.AfterSpacingPt, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 页边距 -->
                                <TextBlock Text="页边距（cm）" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="上" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.PageMarginTopCm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="下" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.PageMarginBottomCm, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="左" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.PageMarginLeftCm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="右" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Settings.Preview.FormatDoc.PageMarginRightCm, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <CheckBox Content="启用页眉页脚" IsChecked="{Binding Settings.Preview.FormatDoc.HeaderFooterEnabled}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="页眉文本" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.HeaderText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="页脚文本" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Preview.FormatDoc.FooterText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
