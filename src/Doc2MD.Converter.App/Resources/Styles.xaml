<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBgMain">#E0E2E6</Color>
    <Color x:Key="ColorBgCard">#FFFFFF</Color>
    <Color x:Key="ColorBgActive">#FFF3E2</Color>
    <Color x:Key="ColorBgSubtle">#F3F4F6</Color>
    <Color x:Key="ColorBgFooter">#F3F4F6</Color>
    <Color x:Key="ColorBgFileList">#F3F4F6</Color>
    <Color x:Key="ColorPrimary">#D98212</Color>
    <Color x:Key="ColorPrimaryHover">#B96700</Color>
    <Color x:Key="ColorPrimarySoft">#FFEDCA</Color>
    <Color x:Key="ColorTextMain">#111827</Color>
    <Color x:Key="ColorTextSecondary">#4B5563</Color>
    <Color x:Key="ColorTextMuted">#6B7280</Color>
    <Color x:Key="ColorTextWeak">#9CA3AF</Color>
    <Color x:Key="ColorBorder">#E5E7EB</Color>
    <Color x:Key="ColorBorderStrong">#D1D5DB</Color>
    <Color x:Key="ColorDivider">#D5D8DD</Color>
    <Color x:Key="ColorSuccess">#16A34A</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorInfo">#2563EB</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource ColorBgMain}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource ColorBgActive}"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="{StaticResource ColorBgSubtle}"/>
    <SolidColorBrush x:Key="BgFooterBrush" Color="{StaticResource ColorBgFooter}"/>
    <SolidColorBrush x:Key="BgFileListBrush" Color="{StaticResource ColorBgFileList}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource ColorPrimarySoft}"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource ColorTextMain}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="TextWeakBrush" Color="{StaticResource ColorTextWeak}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorderStrong}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource ColorDivider}"/>
    <SolidColorBrush x:Key="HeaderButtonHoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="DangerHeaderHoverBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerHeaderForegroundBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SecondaryDisabledBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SecondaryDisabledForegroundBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#FFF8ED"/>
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#D4A84B"/>
    <SolidColorBrush x:Key="SkeletonPrimaryBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SkeletonSecondaryBrush" Color="#E5E7EB"/>

    <!-- Mode icon border (document corner-fold) -->
    <SolidColorBrush x:Key="ModeIconBorderBrush" Color="#D4A84B"/>
    <SolidColorBrush x:Key="ModeIconCornerBrush" Color="#D4A84B"/>

    <!-- Status indicator brushes -->
    <SolidColorBrush x:Key="StatusPendingBgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="StatusProcessingBgBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="StatusDoneBgBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="StatusFailedBgBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="StatusUnsupportedBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="StatusSkippedBgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="StatusPendingFgBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="StatusProcessingFgBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="StatusDoneFgBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="StatusFailedFgBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusUnsupportedFgBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusSkippedFgBrush" Color="#9CA3AF"/>

    <!-- Toast background brushes -->
    <SolidColorBrush x:Key="ToastSuccessBgBrush" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="ToastWarningBgBrush" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="ToastErrorBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="ToastInfoBgBrush" Color="#EFF6FF"/>

    <!-- Tone indicator brushes -->
    <SolidColorBrush x:Key="ToneSuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="ToneWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ToneErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ToneInfoBrush" Color="#2563EB"/>

    <DropShadowEffect x:Key="AppContainerShadow" BlurRadius="16" ShadowDepth="0" Opacity="0.06" Color="#1A1F2B"/>
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="24" ShadowDepth="0" Opacity="0.16" Color="#1A1F2B"/>
    <DropShadowEffect x:Key="AccentShadowEffect" BlurRadius="16" ShadowDepth="0" Opacity="0.10" Color="#D98212"/>

    <!-- Focus visual: 2px dashed primary-color ring, accessible without disabling FocusVisualStyle -->
    <Style x:Key="AppFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource PrimaryBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="4,2"
                               RadiusX="4" RadiusY="4"
                               SnapsToDevicePixels="True"
                               Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BgMainBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
    </Style>

    <!-- Header button: 8px corner -->
    <Style x:Key="AppHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="HeaderScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HeaderButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HeaderButtonHoverBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HeaderScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HeaderScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HeaderScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HeaderScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource AppHeaderButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerHeaderHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerHeaderForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: orange, 8px corner -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PrimaryScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark button (changed to primary orange for v3) -->
    <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <!-- Secondary: 8px corner -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="SecondaryScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource SecondaryDisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryDisabledForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Ghost: now has border (v3: 清空 button uses bordered style) -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GhostScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GhostScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GhostScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GhostScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GhostScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast 内的紧凑操作按钮（F3：输出管理快捷入口） -->
    <Style x:Key="ToastActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- PanelCardStyle: kept for dialogs -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ModeCard: subtle bg, no heavy shadow, 10px corner -->
    <Style x:Key="ModeCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LiftTransform"/>
                        </Border.RenderTransform>
                        <Grid>
                            <ContentPresenter/>
                            <!-- Active overlay: fades in/out for smooth background transition -->
                            <Border x:Name="ActiveOverlay"
                                    Background="{DynamicResource BgActiveBrush}"
                                    CornerRadius="10"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DropZoneBorderBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LiftTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-1"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LiftTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogNavButtonStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BgActiveBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SecondaryHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
</ResourceDictionary>
