<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Doc2MD.Converter.Core</AssemblyName>
    <Version>2.0.0</Version>
    <Company>Doc2MD Converter</Company>
    <Product>Doc2MD Converter</Product>
    <Description>Document conversion and Chinese official document formatting engine</Description>
    <RootNamespace>Doc2MD</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
